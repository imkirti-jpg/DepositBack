{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["nativewind/types"]
  },
  "include": [
    "app",
    "src",
    "src/types/**/*.d.ts",
    "expo-env.d.ts",
    "*.ts",
    "*.tsx",
    "global.css",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
